# Meta Model API (https://dev.meta.ai). Never use -contributor models with private media.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_AUDIO_MODEL=muse-spark-1.2
MUSE_HEAVY_MODEL=muse-wonder-1.0
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# Muse Spark Open on Baseten (hackathon credits)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open

# Neo4j (AuraDB Free: neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
